#!/usr/bin/env bash

set -euo pipefail

CONTEXT="$HOME/.local/bin/project-context"
PROJECT_EXEC="$HOME/.local/bin/project-exec"

usage() {
    cat <<'EOF'
Usage:
  dev
  dev QUERY
  dev .
  dev --describe [QUERY]

Select a Git checkout beneath ~/code and enter its isolated
tmux development session.

Each checkout/worktree receives its own:
  DEV_INSTANCE_ID
  COMPOSE_PROJECT_NAME
  tmux session

Runtime migration is currently advisory. Projects with language
manifests but no mise.toml are reported as not-yet-isolated.
EOF
}

discover_repositories() {
    [[ -d "$HOME/code" ]] || return

    if ! command -v fd >/dev/null 2>&1; then
        echo "dev: fd is required for repository discovery." >&2
        exit 1
    fi

    fd \
        --hidden \
        --no-ignore \
        --max-depth 8 \
        '^\.git$' \
        "$HOME/code" \
        2>/dev/null |
        sed -E 's#/?\.git/?$##' |
        sort -u
}

select_repository() {
    local query="${1:-}"

    if [[ "$query" == "." ]]; then
        git rev-parse --show-toplevel 2>/dev/null || pwd
        return
    fi

    if [[ -n "$query" && -d "$query" ]]; then
        (
            cd "$query"
            pwd -P
        )
        return
    fi

    local repositories
    repositories="$(discover_repositories)"

    if [[ -z "$repositories" ]]; then
        echo "No Git repositories found beneath ~/code." >&2
        exit 1
    fi

    if [[ -n "$query" ]]; then
        local matches
        local count

        matches="$(
            printf '%s\n' "$repositories" |
                grep -i -- "$query" ||
                true
        )"

        count="$(
            printf '%s\n' "$matches" |
                sed '/^$/d' |
                wc -l
        )"

        if [[ "$count" -eq 1 ]]; then
            printf '%s\n' "$matches"
            return
        fi

        printf '%s\n' "$matches" |
            fzf \
                --prompt="project> " \
                --query="$query" \
                --height=80% \
                --reverse

        return
    fi

    printf '%s\n' "$repositories" |
        fzf \
            --prompt="project> " \
            --height=80% \
            --reverse
}

runtime_manifest_present() {
    local root="$1"

    local manifests=(
        package.json
        pyproject.toml
        requirements.txt
        Cargo.toml
        go.mod
        pom.xml
        build.gradle
        build.gradle.kts
        Gemfile
    )

    local file

    for file in "${manifests[@]}"; do
        if [[ -f "$root/$file" ]]; then
            return 0
        fi
    done

    return 1
}

preflight_project() {
    if runtime_manifest_present "$DEV_PROJECT_ROOT" \
        && [[ "$DEV_HAS_MISE" -eq 0 ]]; then

        echo >&2
        echo "dev: isolation advisory:" >&2
        echo "  $DEV_PROJECT_ROOT" >&2
        echo "  has a language/runtime manifest but no mise.toml." >&2
        echo "  It remains usable during Phase 1E migration." >&2
        echo >&2
    fi

    if [[ "$DEV_HAS_MISE" -eq 1 ]]; then
        if ! command -v mise >/dev/null 2>&1; then
            echo "dev: mise.toml exists but mise is unavailable." >&2
            return 1
        fi

        local missing
        local result

        set +e

        missing="$(
            env \
                MISE_PARANOID=1 \
                mise \
                --no-env \
                --no-hooks \
                -C "$DEV_PROJECT_ROOT" \
                ls \
                --missing \
                --no-header \
                2>&1
        )"

        result=$?

        set -e

        if [[ "$result" -ne 0 ]]; then
            echo "dev: unable to validate project mise config:" >&2
            printf '%s\n' "$missing" | sed 's/^/  /' >&2
            echo >&2
            echo "Review the project config first." >&2
            echo "If it is trusted, authorize its current contents with:" >&2
            echo "  mise trust '$DEV_PROJECT_ROOT/mise.toml'" >&2
            return 1
        fi

        if [[ -n "$missing" ]]; then
            echo "dev: project toolchain is not installed:" >&2
            printf '%s\n' "$missing" | sed 's/^/  /' >&2
            echo >&2
            echo "Run from the reviewed project:" >&2
            echo "  mise install" >&2
            return 1
        fi
    fi

    if [[ "$DEV_HAS_ENVRC" -eq 1 ]]; then
        if ! command -v direnv >/dev/null 2>&1; then
            echo "dev: .envrc exists but direnv is unavailable." >&2
            return 1
        fi

        if ! direnv \
            exec \
            "$DEV_PROJECT_ROOT" \
            true \
            >/dev/null \
            2>&1; then

            echo "dev: project .envrc is not authorized or failed." >&2
            echo >&2
            echo "Review it, then explicitly authorize it with:" >&2
            echo "  direnv allow '$DEV_PROJECT_ROOT'" >&2
            return 1
        fi
    fi
}

DESCRIBE=0

if [[ "${1:-}" == "--describe" ]]; then
    DESCRIBE=1
    shift
elif [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

SELECTED="$(
    select_repository "${1:-}"
)"

[[ -n "$SELECTED" ]] || exit 0

if [[ ! -x "$CONTEXT" ]]; then
    echo "dev: project-context is unavailable." >&2
    exit 1
fi

eval "$("$CONTEXT" --shell "$SELECTED")"

if [[ "$DESCRIBE" -eq 1 ]]; then
    "$CONTEXT" "$DEV_PROJECT_ROOT"

    echo
    echo "runtime_manifest=$(
        if runtime_manifest_present "$DEV_PROJECT_ROOT"; then
            echo 1
        else
            echo 0
        fi
    )"

    exit 0
fi

preflight_project

RESOLVER="${HOME}/.local/bin/resolve-dev-agent"
if [[ ! -x "$RESOLVER" ]]; then
    RESOLVER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/resolve-dev-agent"
fi
[[ -x "$RESOLVER" ]] || {
    echo "dev: resolve-dev-agent is unavailable." >&2
    exit 1
}
RESOLVED_AGENT="$("$RESOLVER")" || exit 1

if tmux has-session \
    -t "$DEV_TMUX_SESSION" \
    2>/dev/null; then

    EXISTING_ROOT="$(
        tmux \
            show-environment \
            -t "$DEV_TMUX_SESSION" \
            DEV_PROJECT_ROOT \
            2>/dev/null |
            sed 's/^DEV_PROJECT_ROOT=//'
    )"

    if [[ "$EXISTING_ROOT" != "$DEV_PROJECT_ROOT" ]]; then
        echo "dev: tmux session identity collision detected." >&2
        echo "Expected: $DEV_PROJECT_ROOT" >&2
        echo "Existing: $EXISTING_ROOT" >&2
        exit 1
    fi
else
    tmux new-session \
        -d \
        -s "$DEV_TMUX_SESSION" \
        -c "$DEV_PROJECT_ROOT" \
        -n code \
        -e "DEV_PROJECT_ROOT=$DEV_PROJECT_ROOT" \
        -e "DEV_PROJECT_NAME=$DEV_PROJECT_NAME" \
        -e "DEV_PROJECT_SLUG=$DEV_PROJECT_SLUG" \
        -e "DEV_WORKTREE_HASH=$DEV_WORKTREE_HASH" \
        -e "DEV_INSTANCE_ID=$DEV_INSTANCE_ID" \
        -e "DEV_GIT_BRANCH=$DEV_GIT_BRANCH" \
        -e "DEV_GIT_COMMON_DIR=$DEV_GIT_COMMON_DIR" \
        -e "COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME"

    tmux send-keys \
        -t "$DEV_TMUX_SESSION:code" \
        "$PROJECT_EXEC '$DEV_PROJECT_ROOT' nvim ." \
        C-m

    tmux new-window \
        -d \
        -t "$DEV_TMUX_SESSION" \
        -n agent \
        -c "$DEV_PROJECT_ROOT"

    tmux send-keys \
        -t "$DEV_TMUX_SESSION:agent" \
        "$PROJECT_EXEC '$DEV_PROJECT_ROOT' '$RESOLVED_AGENT'" \
        C-m

    tmux new-window \
        -d \
        -t "$DEV_TMUX_SESSION" \
        -n run \
        -c "$DEV_PROJECT_ROOT"

    tmux select-window \
        -t "$DEV_TMUX_SESSION:code"
fi

if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client \
        -t "$DEV_TMUX_SESSION"
else
    tmux attach-session \
        -t "$DEV_TMUX_SESSION"
fi
