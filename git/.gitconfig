# ===============================================================
# Shared cross-platform Git configuration
# ===============================================================

# ---------------------------------------------------------------
# Identity routing
# ---------------------------------------------------------------

[includeIf "gitdir:~/code/personal/"]
    path = ~/.gitconfig-personal

[includeIf "gitdir:~/code/work/"]
    path = ~/.gitconfig-work

# Personal PC layout.
[includeIf "gitdir:~/code/github.com/ndland/"]
    path = ~/.gitconfig-personal

# ---------------------------------------------------------------
# Machine/platform behavior
# ---------------------------------------------------------------

[includeIf "gitdir:~/code/learning/"]
  path = ~/.gitconfig-personal

# Platform overrides follow identity profiles (Windows SSH on WSL).
[include]
    path = ~/.gitconfig-platform

[core]
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only --syntax-theme=Dracula

[gpg]
    format = ssh

[commit]
    gpgSign = true

[tag]
    forceSignAnnotated = false

[alias]
    lg = log --graph --decorate --oneline --all --pretty=format:'%C(auto)%h %d %s %C(blue)<%an> %C(green)(%cr)'

[delta]
    syntax-theme = Dracula
    line-numbers = true
    side-by-side = true
    navigate = true
    dark = true

# Neovim primary; Cursor remains explicitly available.

[diff]
    tool = nvimdiff

[difftool]
    prompt = false
    trustExitCode = true

[difftool "nvimdiff"]
    cmd = nvim -d "$LOCAL" "$REMOTE"

[difftool "cursor"]
    cmd = cursor --wait --diff "$LOCAL" "$REMOTE"

[merge]
    tool = nvimdiff
    conflictstyle = zdiff3

[mergetool]
    prompt = false
    keepBackup = false

[mergetool "nvimdiff"]
    cmd = nvim -d "$LOCAL" "$MERGED" "$REMOTE" "$BASE"
    trustExitCode = true

[mergetool "cursor"]
    cmd = cursor --wait --merge "$REMOTE" "$LOCAL" "$BASE" "$MERGED"
    trustExitCode = true
[user]
	name = Nick Land
	useConfigOnly = true
[init]
	defaultBranch = main
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[credential "https://origin.cursor.com/git"]
	helper =
	helper = !$HOME/.local/bin/origin credential-helper
[credential "https://origin.cursor.com"]
	helper =
	helper = !$HOME/.local/bin/origin credential-helper
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
