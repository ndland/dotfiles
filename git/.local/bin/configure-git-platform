#!/usr/bin/env bash

set -euo pipefail

CONFIG="$HOME/.gitconfig-platform"
TMP="${CONFIG}.tmp.$$"

ALLOWED_DIR="$HOME/.config/git"
ALLOWED_SIGNERS="$ALLOWED_DIR/allowed_signers"
ALLOWED_TMP=""
KEY_TMP=""

PERSONAL_CONFIG="$HOME/.gitconfig-personal"
WORK_CONFIG="$HOME/.gitconfig-work"

cleanup() {
    rm -f "$TMP"

    if [[ -n "${ALLOWED_TMP}" ]]; then
        rm -f "$ALLOWED_TMP"
    fi

    if [[ -n "${KEY_TMP}" ]]; then
        rm -f "$KEY_TMP"
    fi
}

trap cleanup EXIT

: > "$TMP"

extract_signer() {
    local role="$1"
    local config="$2"

    if [[ ! -f "$config" ]]; then
        echo "ERROR: ${role} Git identity config not found: $config" >&2
        return 20
    fi

    local email
    local key
    local core

    email="$(
        git config \
            --file "$config" \
            --get user.email
    )"

    key="$(
        git config \
            --file "$config" \
            --get user.signingkey
    )"

    if [[ -z "$email" ]]; then
        echo "ERROR: ${role} Git email is empty." >&2
        return 21
    fi

    case "$key" in
        key::*)
            key="${key#key::}"
            ;;

        ssh-*|ecdsa-*|sk-*)
            ;;

        *)
            echo "ERROR: ${role} signing key is not an inline SSH public key." >&2
            return 22
            ;;
    esac

    core="$(
        printf '%s\n' "$key" |
            awk '
                NF >= 2 {
                    print $1 " " $2
                    exit
                }
            '
    )"

    if [[ -z "$core" ]]; then
        echo "ERROR: ${role} SSH public key cannot be parsed." >&2
        return 23
    fi

    printf '%s %s\n' \
        "$email" \
        "$core"
}

export_public_key() {
    local role="$1"
    local config="$2"
    local key
    local key_dir="$HOME/.config/git/ssh"

    key="$(
        git config \
            --file "$config" \
            --get user.signingkey
    )"

    key="${key#key::}"

    if [[ -f "$key" ]]; then
        key="$(cat "$key")"
    fi

    key="$(
        printf '%s\n' "$key" |
            awk '
                /^(ssh-|ecdsa-|sk-)/ && NF >= 2 {
                    print $1 " " $2
                    exit
                }
            '
    )"

    if [[ -z "$key" ]]; then
        echo "ERROR: ${role} SSH public key cannot be parsed." >&2
        return 26
    fi

    mkdir -p "$key_dir"

    KEY_TMP="$(
        mktemp "$key_dir/.${role}.pub.tmp.XXXXXX"
    )"

    printf '%s\n' "$key" > "$KEY_TMP"

    if ! ssh-keygen -lf "$KEY_TMP" >/dev/null; then
        echo "ERROR: ${role} SSH signing key is invalid." >&2
        return 27
    fi

    chmod 600 "$KEY_TMP"
    mv "$KEY_TMP" "$key_dir/$role.pub"
    KEY_TMP=""
}

OS="$(uname -s)"

IS_WSL=0

if [[ -n "${WSL_DISTRO_NAME:-}" ]] \
    || grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
    IS_WSL=1
fi

if [[ "$IS_WSL" -eq 1 ]]; then
    echo "Detected platform: WSL"

    SSH_EXE=""

    if command -v ssh.exe >/dev/null 2>&1; then
        SSH_EXE="ssh.exe"
    elif [[ -x /mnt/c/Windows/System32/OpenSSH/ssh.exe ]]; then
        SSH_EXE="/mnt/c/Windows/System32/OpenSSH/ssh.exe"
    fi

    if [[ -z "$SSH_EXE" ]]; then
        echo "ERROR: Windows OpenSSH was not found." >&2
        exit 10
    fi

    SIGNER=""

    if command -v op-ssh-sign-wsl.exe >/dev/null 2>&1; then
        SIGNER="$(command -v op-ssh-sign-wsl.exe)"
    else
        CMD_EXE=""

        if command -v cmd.exe >/dev/null 2>&1; then
            CMD_EXE="$(command -v cmd.exe)"
        elif [[ -x /mnt/c/Windows/System32/cmd.exe ]]; then
            CMD_EXE="/mnt/c/Windows/System32/cmd.exe"
        fi

        if [[ -n "$CMD_EXE" ]]; then
            WIN_PROFILE="$(
                "$CMD_EXE" /d /c 'echo %USERPROFILE%' \
                    2>/dev/null |
                    tr -d '\r' |
                    tail -n 1
            )"

            if [[ -n "$WIN_PROFILE" ]]; then
                WSL_PROFILE="$(
                    wslpath -u "$WIN_PROFILE" \
                        2>/dev/null || true
                )"

                CANDIDATE="$WSL_PROFILE/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"

                if [[ -f "$CANDIDATE" ]]; then
                    SIGNER="$CANDIDATE"
                fi
            fi
        fi
    fi

    if [[ -z "$SIGNER" ]]; then
        echo "ERROR: 1Password WSL signing executable not found." >&2
        exit 11
    fi

    git config \
        -f "$TMP" \
        gpg.ssh.program \
        "$SIGNER"

    git config \
        -f "$TMP" \
        core.sshCommand \
        "$HOME/.local/bin/git-ssh-role"

elif [[ "$OS" == "Darwin" ]]; then
    echo "Detected platform: macOS"

    SIGNER="/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

    if [[ ! -x "$SIGNER" ]]; then
        echo "ERROR: macOS 1Password SSH signer not found." >&2
        exit 12
    fi

    git config \
        -f "$TMP" \
        gpg.ssh.program \
        "$SIGNER"

else
    echo "Detected platform: Linux"

    SIGNER=""

    if command -v op-ssh-sign >/dev/null 2>&1; then
        SIGNER="$(command -v op-ssh-sign)"
    elif [[ -x /opt/1Password/op-ssh-sign ]]; then
        SIGNER="/opt/1Password/op-ssh-sign"
    fi

    if [[ -n "$SIGNER" ]]; then
        git config \
            -f "$TMP" \
            gpg.ssh.program \
            "$SIGNER"
    else
        echo "WARN: no 1Password SSH signer detected."
    fi
fi

mkdir -p "$ALLOWED_DIR"

ALLOWED_TMP="$(
    mktemp \
        "$ALLOWED_DIR/.allowed_signers.tmp.XXXXXX"
)"

extract_signer \
    "personal" \
    "$PERSONAL_CONFIG" \
    > "$ALLOWED_TMP"

export_public_key "personal" "$PERSONAL_CONFIG"

if [[ -f "$WORK_CONFIG" ]]; then
    extract_signer \
        "work" \
        "$WORK_CONFIG" \
        >> "$ALLOWED_TMP"
    export_public_key "work" "$WORK_CONFIG"
else
    echo "WARN: no ~/.gitconfig-work; work identity is not configured." >&2
fi

ENTRY_COUNT="$(
    awk \
        'NF && $1 !~ /^#/ { count++ } END { print count+0 }' \
        "$ALLOWED_TMP"
)"

EXPECTED_ENTRIES=1
if [[ -f "$WORK_CONFIG" ]]; then
    EXPECTED_ENTRIES=2
fi

if [[ "$ENTRY_COUNT" -ne "$EXPECTED_ENTRIES" ]]; then
    echo "ERROR: expected $EXPECTED_ENTRIES SSH verification principal(s)." >&2
    exit 24
fi

DUPLICATE_PRINCIPAL="$(
    awk \
        'NF && $1 !~ /^#/ { print $1 }' \
        "$ALLOWED_TMP" |
        sort |
        uniq -d |
        head -n 1
)"

if [[ -n "$DUPLICATE_PRINCIPAL" ]]; then
    echo "ERROR: duplicate SSH verification principal: $DUPLICATE_PRINCIPAL" >&2
    exit 25
fi

chmod 600 "$TMP"
chmod 600 "$ALLOWED_TMP"

mv "$TMP" "$CONFIG"
mv "$ALLOWED_TMP" "$ALLOWED_SIGNERS"

ALLOWED_TMP=""

trap - EXIT

echo "Platform Git config generated."
echo "SSH verification trust store generated."
