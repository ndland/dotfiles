# Bootstrap set for a new Mac. Audited against this machine's brew leaves,
# fish history, and app last-used dates. Not a dump of every library.

# Shell and prompt
brew "fish"
brew "fisher"
brew "oh-my-posh"
brew "direnv"
brew "fnm"
brew "zoxide"

# Editor and file tools (y, lg, ls, bat, vale, zk)
brew "neovim"
brew "yazi"
brew "ffmpeg-full"
brew "imagemagick-full"
brew "poppler"
brew "resvg"
brew "sevenzip"
brew "lazygit"
brew "eza"
brew "bat"
brew "vale"
brew "zk"
brew "buku"
brew "btop"

# Git and GitHub
brew "git"
brew "git-delta"
brew "gh"
brew "act"
brew "beads"
brew "jfrog-cli"

# Search / fuzzy / JSON
brew "ripgrep"
brew "fd"
brew "fzf"
brew "jq"

# Bootstrap and misc
brew "stow"
brew "tmux"
brew "uv"
brew "wget"
brew "task"

# GUI — used in the last few weeks
cask "1password"
cask "brave-browser"
cask "cursor"
cask "cursor-cli"
cask "docker-desktop"
cask "dracula-insomnia"
cask "fantastical"
cask "ghostty"
cask "insomnia"
cask "obsidian"
cask "raycast"
cask "wezterm@nightly"

# Fonts used by WezTerm and Cursor
cask "font-iosevka-etoile"
cask "font-iosevka-nerd-font"
cask "font-iosevka-term-nerd-font"
